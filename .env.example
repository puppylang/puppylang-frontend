# 로컬 실행 시 이 파일을 .env.local 로 복사한 뒤 값을 채워주세요.
#   cp .env.example .env.local
# .env.local 은 .gitignore 에 포함되어 커밋되지 않습니다.

# ─────────────────────────────────────────────
# [필수] 없으면 모든 페이지가 "Application error"로 죽습니다. (src/app/clientLayout.tsx)
# ─────────────────────────────────────────────

# 카카오 JavaScript 키 — 카카오 로그인 SDK + 카카오맵 SDK 공용
# 발급: Kakao Developers > 내 애플리케이션 > 앱 키 > "JavaScript 키"
# 추가 설정: 플랫폼 > Web 에 사이트 도메인(예: http://localhost:3000) 등록
NEXT_PUBLIC_KAKAO_KEY=

# ─────────────────────────────────────────────
# [로그인 시 필수] 비워도 화면은 뜨지만 소셜 로그인이 동작하지 않습니다. (src/app/page.tsx)
# ─────────────────────────────────────────────

# 소셜 로그인(카카오/네이버/애플) 공통 콜백 주소 — /login/success 페이지가 처리
# 예: http://localhost:3000/login/success
# 추가 설정: 카카오·네이버·애플 콘솔 각각에 같은 Redirect URI 등록
NEXT_PUBLIC_REDIRECT_URI=

# 네이버 로그인 Client ID
# 발급: NAVER Developers > Application > 내 애플리케이션 > Client ID
NEXT_PUBLIC_NAVER_CLIENT_ID=

# ─────────────────────────────────────────────
# [선택] Sentry — 로컬 개발에서는 비워도 됩니다.
# ─────────────────────────────────────────────

# 에러 수집 DSN. 비우면 Sentry 전송이 비활성화됩니다. (sentry.*.config.ts)
NEXT_PUBLIC_SENTRY_DSN=

# 빌드 시 소스맵 업로드용 (next.config.js withSentryConfig). next dev 에는 필요 없습니다.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
